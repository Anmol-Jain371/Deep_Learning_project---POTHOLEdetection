runs/benchmark/*.mp4
runs/benchmark/**/*.mp4
mobile_sam.pt
runs/detect/pothole_v8_upgraded/
runs/faster_rcnn/*.pth

# Scratch & temporary artifacts
scratch_*
*.tmp
.tempmediaStorage/
.gemini/

